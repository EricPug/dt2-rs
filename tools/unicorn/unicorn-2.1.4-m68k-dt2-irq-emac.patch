+/* digikit: the raw EMAC register file (macc[] is the 48-bit accumulator the
+ * guest's ACC/ACCext reads are derived from; reading those saturates). */
+UNICORN_EXPORT
+void uc_digikit_emac_get(uc_engine *uc, uint64_t macc[4], uint32_t *macsr,
+                         uint32_t *mask)
+{
+    CPUM68KState *env = &M68K_CPU(uc->cpu)->env;
+    int i;
+
+    for (i = 0; i < 4; i++) {
+        macc[i] = env->macc[i];
+    }
+    *macsr = env->macsr;
+    *mask = env->mac_mask;
+}
+
+UNICORN_EXPORT
+void uc_digikit_emac_set(uc_engine *uc, const uint64_t macc[4], uint32_t macsr,
+                         uint32_t mask)
+{
+    CPUM68KState *env = &M68K_CPU(uc->cpu)->env;
+    int i;
+
+    for (i = 0; i < 4; i++) {
+        env->macc[i] = macc[i];
+    }
+    env->macsr = macsr;
+    env->mac_mask = mask;
+}
